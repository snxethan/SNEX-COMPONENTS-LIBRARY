{
  "name": "@snxethan/snex-components",
  "version": "0.3.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "lucide-react": "^0.470.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.0",
    "next": "^16.3.3",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -c tailwind-build.cjs -i src/styles.css -o dist/index.css --minify",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "description": "Shared React components extracted from ethantownsend.dev. Framework-agnostic: no Next.js required.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snxethan/snex-components.git"
  },
  "license": "MIT"
}